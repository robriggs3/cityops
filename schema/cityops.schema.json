{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityops.robriggs.com/schema/cityops.schema.json",
  "title": "CityOps city guide (schema v1)",
  "description": "The interchange contract for CityOps city data: standalone guides, the app, exports, sync rows, and AI-generated payloads all read and write this shape. NOTE ON AUTHORITY: the runtime validator (src/cityops.js: validate/validateItem/validateIntel) is the enforcement boundary and is deliberately a permissive subset of this document. Enforced at runtime: root/schema/city.name/city.dates presence, sections id+label, item id uniqueness and section references, status enum, item day format, and the full intel rules. Documented here but tolerated at runtime (advisory): links[].kind and hours.class enums, city.dates format, place_id/verified presence, and all optional field shapes. One rule points the other way: item id uniqueness across the items array is enforced at runtime but is not expressible in JSON Schema.",
  "type": "object",
  "required": ["schema", "city", "sections", "items"],
  "properties": {
    "schema": { "const": 1 },
    "city": {
      "type": "object",
      "required": ["name", "dates"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "maxLength": 3 },
        "dates": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/isoDate" },
            "to": { "$ref": "#/$defs/isoDate" }
          }
        },
        "accommodation": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "currency": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "usd": { "type": "number" }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "icon": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "item": {
      "type": "object",
      "required": ["id", "section", "status", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "section": {
          "type": "string",
          "minLength": 1,
          "$comment": "Must reference a declared sections[].id; enforced by the runtime validator, not expressible here."
        },
        "status": { "enum": ["plan", "backup", "archived", "done"] },
        "day": { "$ref": "#/$defs/isoDate" },
        "when": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "price": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        },
        "note": { "type": "string" },
        "hours": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "class": { "enum": ["late", "day", "eve"] }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "label", "href"],
            "properties": {
              "kind": { "enum": ["map", "web", "tel"] },
              "label": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        },
        "intel": { "$ref": "#/$defs/intel" },
        "place_id": { "type": ["string", "null"] },
        "verified": { "enum": [true, "differed", null] }
      }
    },
    "intel": {
      "type": "object",
      "properties": {
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tier", "text"],
            "properties": {
              "tier": { "enum": ["must", "good", "skip"] },
              "text": { "$ref": "#/$defs/nonBlank" }
            }
          }
        },
        "tips": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "source": { "type": "string" }
      }
    },
    "delta": {
      "$comment": "The partial payload accepted by mergeDelta (Enrich): schema 1, delta true, optional new sections, optional new items (status restricted to plan|backup), optional intel map keyed by existing item id.",
      "type": "object",
      "required": ["schema", "delta"],
      "properties": {
        "schema": { "const": 1 },
        "delta": { "const": true },
        "sections": { "$ref": "#/properties/sections" },
        "items": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/item" },
              { "properties": { "status": { "enum": ["plan", "backup"] } } }
            ]
          }
        },
        "intel": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/intel" }
        }
      }
    }
  }
}
